+/**
+ * Iuran lingkungan — admin RT/RW menagih warganya sendiri.
+ *
+ * Berbeda dengan `billing.ts` (langganan aplikasi: superadmin → admin),
+ * uang iuran masuk ke kas lingkungan. Aplikasi hanya mencatat siapa sudah
+ * bayar dan siapa belum; tidak ada uang yang lewat sistem.
+ *
+ * Yang ditagih adalah RUMAH, bukan akun. Satu rumah bisa punya beberapa
+ * akun (suami, istri, anak) — semuanya melihat tagihan yang sama dan
+ * siapa pun boleh membayarnya. Rumah yang belum memasang aplikasi tetap
+ * didata agar buku kas tetap lengkap.
+ *
+ * Dua cara pelunasan, keduanya berakhir di tangan admin:
+ *   a. Tunai   — warga bayar ke pengurus, admin menekan "Tandai lunas".
+ *   b. QRIS/transfer — warga bayar sendiri lalu menekan "Saya sudah
+ *      bayar" (status menunggu verifikasi), admin menyetujui.
+ */
+import { DAY, audit, db, now, uid } from './db.js'
+import {
+  clampAmount,
+  dueDateOf,
+  periodOf,
+  periodTitle,
+  safeDueDay,
+} from './dues-calc.js'
+
+// Hitungan murni tinggal di dues-calc.ts agar bisa diuji tanpa SQLite;
+// diekspor ulang di sini supaya pemanggil cukup mengenal satu modul.
+export {
+  DUES_MAX_AMOUNT,
+  dueDateOf,
+  periodOf,
+  periodTitle,
+  summarize,
+  type BillSummary,
+} from './dues-calc.js'
+
+export interface DuesSettingsRow {
+  community_id: string
+  amount: number
+  auto_monthly: number
+  due_day: number
+  pay_info: string
+  qris_image: string | null
+  updated_at: number
+  updated_by: string
+}
+
+export interface HouseRow {
+  id: string
+  community_id: string
+  label: string
+  head_name: string
+  amount: number | null
+  active: number
+  note: string
+  created_at: number
+  created_by: string
+}
+
+export interface ChargeRow {
+  id: string
+  bill_id: string
+  community_id: string
+  house_id: string
+  house_label: string
+  amount: number
+  status: string
+  method: string | null
+  reference: string
+  note: string
+  claimed_by: string | null
+  claimed_at: number | null
+  paid_at: number | null
+  settled_by: string | null
+  created_at: number
+}
+
+export interface BillRow {
+  id: string
+  community_id: string
+  title: string
+  kind: string
+  period: string
+  due_at: number | null
+  created_at: number
+  created_by: string
+}
+
+/* ---------------- pengaturan ---------------- */
+
+export function getSettings(communityId: string): DuesSettingsRow {
+  const row = db
+    .prepare('SELECT * FROM dues_settings WHERE community_id=?')
+    .get(communityId) as DuesSettingsRow | undefined
+  if (row) return row
+  return {
+    community_id: communityId,
+    amount: 0,
+    auto_monthly: 0,
+    due_day: 10,
+    pay_info: '',
+    qris_image: null,
+    updated_at: 0,
+    updated_by: '',
+  }
+}
+
+export interface SettingsPatch {
+  amount?: number
+  autoMonthly?: boolean
+  dueDay?: number
+  payInfo?: string
+  /** data URL gambar QRIS; string kosong menghapus. */
+  qrisImage?: string | null
+}
+
+export function saveSettings(
+  communityId: string,
+  actorId: string,
+  patch: SettingsPatch,
+): DuesSettingsRow {
+  const cur = getSettings(communityId)
+  const next: DuesSettingsRow = {
+    ...cur,
+    amount: patch.amount === undefined ? cur.amount : clampAmount(patch.amount),
+    auto_monthly:
+      patch.autoMonthly === undefined ? cur.auto_monthly : patch.autoMonthly ? 1 : 0,
+    due_day: patch.dueDay === undefined ? cur.due_day : safeDueDay(patch.dueDay),
+    pay_info: patch.payInfo === undefined ? cur.pay_info : patch.payInfo.slice(0, 500),
+    qris_image:
+      patch.qrisImage === undefined ? cur.qris_image : patch.qrisImage || null,
+    updated_at: now(),
+    updated_by: actorId,
+  }
+  db.prepare(
+    `INSERT INTO dues_settings
+       (community_id, amount, auto_monthly, due_day, pay_info, qris_image,
+        updated_at, updated_by)
+     VALUES (?,?,?,?,?,?,?,?)
+     ON CONFLICT(community_id) DO UPDATE SET
+       amount=excluded.amount, auto_monthly=excluded.auto_monthly,
+       due_day=excluded.due_day, pay_info=excluded.pay_info,
+       qris_image=excluded.qris_image, updated_at=excluded.updated_at,
+       updated_by=excluded.updated_by`,
+  ).run(
+    communityId,
+    next.amount,
+    next.auto_monthly,
+    next.due_day,
+    next.pay_info,
+    next.qris_image,
+    next.updated_at,
+    next.updated_by,
+  )
+  audit(communityId, actorId, 'dues.settings', `${next.amount} auto=${next.auto_monthly}`)
+  return next
+}
+
+/* ---------------- rumah ---------------- */
+
+export function listHouses(communityId: string): HouseRow[] {
+  return db
+    .prepare('SELECT * FROM houses WHERE community_id=? ORDER BY label COLLATE NOCASE')
+    .all(communityId) as HouseRow[]
+}
+
+export function getHouse(id: string): HouseRow | null {
+  return (db.prepare('SELECT * FROM houses WHERE id=?').get(id) as HouseRow) ?? null
+}
+
+export function findHouseByLabel(communityId: string, label: string): HouseRow | null {
+  return (
+    (db
+      .prepare('SELECT * FROM houses WHERE community_id=? AND lower(label)=lower(?)')
+      .get(communityId, label.trim()) as HouseRow) ?? null
+  )
+}
+
+export interface HouseInput {
+  label: string
+  headName?: string
+  amount?: number | null
+  active?: boolean
+  note?: string
+}
+
+export function addHouse(
+  communityId: string,
+  actorId: string,
+  input: HouseInput,
+): HouseRow {
+  const label = input.label.trim().slice(0, 40)
+  if (!label) throw new DuesError('houseLabelRequired')
+  if (findHouseByLabel(communityId, label)) throw new DuesError('houseExists')
+  const row: HouseRow = {
+    id: uid('h_'),
+    community_id: communityId,
+    label,
+    head_name: (input.headName ?? '').trim().slice(0, 80),
+    amount: input.amount == null ? null : clampAmount(input.amount),
+    active: input.active === false ? 0 : 1,
+    note: (input.note ?? '').slice(0, 200),
+    created_at: now(),
+    created_by: actorId,
+  }
+  db.prepare(
+    `INSERT INTO houses
+       (id, community_id, label, head_name, amount, active, note, created_at, created_by)
+     VALUES (?,?,?,?,?,?,?,?,?)`,
+  ).run(
+    row.id,
+    row.community_id,
+    row.label,
+    row.head_name,
+    row.amount,
+    row.active,
+    row.note,
+    row.created_at,
+    row.created_by,
+  )
+  audit(communityId, actorId, 'dues.house.add', label)
+  return row
+}
+
+export function updateHouse(
+  id: string,
+  actorId: string,
+  input: Partial<HouseInput>,
+): HouseRow {
+  const cur = getHouse(id)
+  if (!cur) throw new DuesError('notFound')
+  const label = input.label === undefined ? cur.label : input.label.trim().slice(0, 40)
+  if (!label) throw new DuesError('houseLabelRequired')
+  const clash = findHouseByLabel(cur.community_id, label)
+  if (clash && clash.id !== id) throw new DuesError('houseExists')
+  const next: HouseRow = {
+    ...cur,
+    label,
+    head_name:
+      input.headName === undefined ? cur.head_name : input.headName.trim().slice(0, 80),
+    amount:
+      input.amount === undefined
+        ? cur.amount
+        : input.amount == null
+          ? null
+          : clampAmount(input.amount),
+    active: input.active === undefined ? cur.active : input.active ? 1 : 0,
+    note: input.note === undefined ? cur.note : input.note.slice(0, 200),
+  }
+  db.prepare(
+    'UPDATE houses SET label=?, head_name=?, amount=?, active=?, note=? WHERE id=?',
+  ).run(next.label, next.head_name, next.amount, next.active, next.note, id)
+  audit(cur.community_id, actorId, 'dues.house.edit', next.label)
+  return next
+}
+
+/**
+ * Hapus rumah. Riwayat tagihannya ikut terhapus (ON DELETE CASCADE),
+ * jadi untuk rumah yang sekadar tidak ditagih lagi, pakai `active=false`.
+ */
+export function removeHouse(id: string, actorId: string): void {
+  const cur = getHouse(id)
+  if (!cur) throw new DuesError('notFound')
+  db.prepare('DELETE FROM houses WHERE id=?').run(id)
+  audit(cur.community_id, actorId, 'dues.house.remove', cur.label)
+}
+
+/**
+ * Buat data rumah dari nomor rumah yang sudah diisi anggota saat mendaftar,
+ * sehingga admin tidak perlu mengetik ulang daftar rumah.
+ *
+ * Hanya menambah yang belum ada — tidak pernah menimpa data admin.
+ */
+export function syncHousesFromMembers(communityId: string, actorId: string): number {
+  const rows = db
+    .prepare(
+      `SELECT house, MIN(name) AS name FROM members
+        WHERE community_id=? AND status='active' AND TRIM(house) <> ''
+        GROUP BY lower(TRIM(house))`,
+    )
+    .all(communityId) as { house: string; name: string }[]
+  let added = 0
+  for (const r of rows) {
+    const label = r.house.trim()
+    if (findHouseByLabel(communityId, label)) continue
+    addHouse(communityId, actorId, { label, headName: r.name })
+    added += 1
+  }
+  return added
+}
+
+/** Rumah milik seorang anggota, dicocokkan lewat nomor rumahnya. */
+export function houseOfMember(
+  communityId: string,
+  house: string | null,
+): HouseRow | null {
+  if (!house || !house.trim()) return null
+  return findHouseByLabel(communityId, house)
+}
+
+/** Berapa yang ditagih ke sebuah rumah. */
+export function amountFor(house: HouseRow, settings: DuesSettingsRow): number {
+  return house.amount == null ? settings.amount : house.amount
+}
+
+/* ---------------- penagihan ---------------- */
+
+export class DuesError extends Error {
+  readonly code: string
+  constructor(code: string) {
+    super(code)
+    this.code = code
+  }
+}
+
+/** Nomor rujukan pembayaran iuran; pendek dan tanpa huruf rancu. */
+export function duesReference(): string {
+  const ALPHABET = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'
+  for (let attempt = 0; attempt < 20; attempt++) {
+    let code = 'IUR'
+    for (let i = 0; i < 5; i++) {
+      code += ALPHABET[Math.floor(Math.random() * ALPHABET.length)]
+    }
+    if (!db.prepare('SELECT 1 FROM dues_charges WHERE reference=?').get(code)) return code
+  }
+  return `IUR${uid('').slice(-5).toUpperCase()}`
+}
+
+export interface CreateBillInput {
+  communityId: string
+  actorId: string
+  title?: string
+  kind?: 'monthly' | 'special'
+  /** 'YYYY-MM'; wajib untuk iuran bulanan. */
+  period?: string
+  dueAt?: number | null
+  /** Bila diisi, hanya rumah ini yang ditagih. Default: semua rumah aktif. */
+  houseIds?: string[]
+  /** Nominal seragam untuk penagihan ini (mis. iuran 17-an). */
+  amount?: number
+}
+
+export interface BillWithCharges {
+  bill: BillRow
+  charges: ChargeRow[]
+}
+
+/**
+ * Buat satu penagihan beserta tagihan tiap rumah.
+ *
+ * Rumah tanpa nominal (bawaan 0 dan tanpa nominal khusus) dilewati —
+ * menagih Rp0 hanya mengotori daftar.
+ */
+export function createBill(input: CreateBillInput): BillWithCharges {
+  const kind = input.kind === 'special' ? 'special' : 'monthly'
+  const period = kind === 'monthly' ? (input.period || periodOf(now())) : ''
+  const settings = getSettings(input.communityId)
+
+  if (kind === 'monthly' && billOfPeriod(input.communityId, period))
+    throw new DuesError('billExists')
+
+  const all = listHouses(input.communityId).filter((h) => h.active === 1)
+  const picked = input.houseIds?.length
+    ? all.filter((h) => input.houseIds!.includes(h.id))
+    : all
+  if (picked.length === 0) throw new DuesError('noHouses')
+
+  const at = now()
+  const bill: BillRow = {
+    id: uid('bill_'),
+    community_id: input.communityId,
+    title:
+      (input.title ?? '').trim().slice(0, 80) ||
+      (kind === 'monthly' ? periodTitle(period) : 'Iuran'),
+    kind,
+    period,
+    due_at:
+      input.dueAt === undefined
+        ? kind === 'monthly'
+          ? dueDateOf(period, settings.due_day)
+          : at + 14 * DAY
+        : input.dueAt,
+    created_at: at,
+    created_by: input.actorId,
+  }
+
+  const charges: ChargeRow[] = []
+  const tx = db.transaction(() => {
+    db.prepare(
+      `INSERT INTO dues_bills
+         (id, community_id, title, kind, period, due_at, created_at, created_by)
+       VALUES (?,?,?,?,?,?,?,?)`,
+    ).run(
+      bill.id,
+      bill.community_id,
+      bill.title,
+      bill.kind,
+      bill.period,
+      bill.due_at,
+      bill.created_at,
+      bill.created_by,
+    )
+    for (const h of picked) {
+      const amount =
+        input.amount === undefined ? amountFor(h, settings) : clampAmount(input.amount)
+      if (amount <= 0) continue
+      const row: ChargeRow = {
+        id: uid('due_'),
+        bill_id: bill.id,
+        community_id: input.communityId,
+        house_id: h.id,
+        house_label: h.label,
+        amount,
+        status: 'unpaid',
+        method: null,
+        reference: duesReference(),
+        note: '',
+        claimed_by: null,
+        claimed_at: null,
+        paid_at: null,
+        settled_by: null,
+        created_at: at,
+      }
+      db.prepare(
+        `INSERT INTO dues_charges
+           (id, bill_id, community_id, house_id, house_label, amount, status,
+            reference, created_at)
+         VALUES (?,?,?,?,?,?,'unpaid',?,?)`,
+      ).run(
+        row.id,
+        row.bill_id,
+        row.community_id,
+        row.house_id,
+        row.house_label,
+        row.amount,
+        row.reference,
+        row.created_at,
+      )
+      charges.push(row)
+    }
+  })
+  tx()
+
+  if (charges.length === 0) {
+    db.prepare('DELETE FROM dues_bills WHERE id=?').run(bill.id)
+    throw new DuesError('noAmount')
+  }
+
+  audit(
+    input.communityId,
+    input.actorId,
+    'dues.bill',
+    `${bill.title} · ${charges.length} rumah`,
+  )
+  return { bill, charges }
+}
+
+export function billOfPeriod(communityId: string, period: string): BillRow | null {
+  return (
+    (db
+      .prepare('SELECT * FROM dues_bills WHERE community_id=? AND period=?')
+      .get(communityId, period) as BillRow) ?? null
+  )
+}
+
+export function listBills(communityId: string, limit = 24): BillRow[] {
+  return db
+    .prepare(
+      'SELECT * FROM dues_bills WHERE community_id=? ORDER BY created_at DESC LIMIT ?',
+    )
+    .all(communityId, limit) as BillRow[]
+}
+
+export function getBill(id: string): BillRow | null {
+  return (db.prepare('SELECT * FROM dues_bills WHERE id=?').get(id) as BillRow) ?? null
+}
+
+export function getCharge(id: string): ChargeRow | null {
+  return (
+    (db.prepare('SELECT * FROM dues_charges WHERE id=?').get(id) as ChargeRow) ?? null
+  )
+}
+
+export function chargesOfBill(billId: string): ChargeRow[] {
+  return db
+    .prepare(
+      'SELECT * FROM dues_charges WHERE bill_id=? ORDER BY house_label COLLATE NOCASE',
+    )
+    .all(billId) as ChargeRow[]
+}
+
+export function chargesOfHouse(houseId: string, limit = 24): ChargeRow[] {
+  return db
+    .prepare('SELECT * FROM dues_charges WHERE house_id=? ORDER BY created_at DESC LIMIT ?')
+    .all(houseId, limit) as ChargeRow[]
+}
+
+/** Hapus satu penagihan beserta tagihannya (mis. salah buat). */
+export function removeBill(id: string, actorId: string): void {
+  const bill = getBill(id)
+  if (!bill) throw new DuesError('notFound')
+  db.prepare('DELETE FROM dues_bills WHERE id=?').run(id)
+  audit(bill.community_id, actorId, 'dues.bill.remove', bill.title)
+}
+
+/* ---------------- pelunasan ---------------- */
+
+/** Admin menandai lunas (biasanya pembayaran tunai ke pengurus). */
+export function markPaid(
+  chargeId: string,
+  actorId: string,
+  method: 'cash' | 'transfer' | 'qris' = 'cash',
+  note = '',
+): ChargeRow {
+  const cur = getCharge(chargeId)
+  if (!cur) throw new DuesError('notFound')
+  if (cur.status === 'paid') return cur
+  db.prepare(
+    `UPDATE dues_charges
+        SET status='paid', method=?, paid_at=?, settled_by=?, note=?
+      WHERE id=?`,
+  ).run(method, now(), actorId, note.slice(0, 200) || cur.note, chargeId)
+  audit(
+    cur.community_id,
+    actorId,
+    'dues.paid',
+    `${cur.house_label} ${cur.amount} ${method}`,
+  )
+  return getCharge(chargeId)!
+}
+
+/** Warga menekan "saya sudah bayar" — menunggu verifikasi admin. */
+export function claimCharge(
+  chargeId: string,
+  memberId: string,
+  method: 'transfer' | 'qris' = 'qris',
+  note = '',
+): ChargeRow {
+  const cur = getCharge(chargeId)
+  if (!cur) throw new DuesError('notFound')
+  if (cur.status === 'paid') throw new DuesError('alreadyPaid')
+  if (cur.status === 'waived') throw new DuesError('notFound')
+  db.prepare(
+    `UPDATE dues_charges
+        SET status='awaiting_verification', method=?, claimed_by=?, claimed_at=?, note=?
+      WHERE id=?`,
+  ).run(method, memberId, now(), note.slice(0, 200), chargeId)
+  audit(cur.community_id, memberId, 'dues.claim', `${cur.house_label} ${cur.reference}`)
+  return getCharge(chargeId)!
+}
+
+/** Admin menolak klaim warga; tagihan kembali ke status belum bayar. */
+export function rejectClaim(chargeId: string, actorId: string, note = ''): ChargeRow {
+  const cur = getCharge(chargeId)
+  if (!cur) throw new DuesError('notFound')
+  db.prepare(
+    `UPDATE dues_charges
+        SET status='unpaid', claimed_by=NULL, claimed_at=NULL, note=?
+      WHERE id=?`,
+  ).run(note.slice(0, 200), chargeId)
+  audit(cur.community_id, actorId, 'dues.reject', `${cur.house_label} ${note}`)
+  return getCharge(chargeId)!
+}
+
+/** Bebaskan satu rumah dari tagihan tertentu (keringanan). */
+export function waiveCharge(chargeId: string, actorId: string, note = ''): ChargeRow {
+  const cur = getCharge(chargeId)
+  if (!cur) throw new DuesError('notFound')
+  db.prepare(
+    `UPDATE dues_charges SET status='waived', settled_by=?, note=? WHERE id=?`,
+  ).run(actorId, note.slice(0, 200), chargeId)
+  audit(cur.community_id, actorId, 'dues.waive', `${cur.house_label} ${note}`)
+  return getCharge(chargeId)!
+}
+
+/* ---------------- iuran bulanan otomatis ---------------- */
+
+/**
+ * Buat tagihan bulanan untuk semua lingkungan yang mengaktifkannya.
+ * Aman dipanggil berkali-kali: indeks unik per periode menolak duplikat.
+ */
+export function runMonthlyDues(at = now()): number {
+  const period = periodOf(at)
+  const rows = db
+    .prepare('SELECT * FROM dues_settings WHERE auto_monthly=1 AND amount > 0')
+    .all() as DuesSettingsRow[]
+  let created = 0
+  for (const s of rows) {
+    if (billOfPeriod(s.community_id, period)) continue
+    try {
+      createBill({
+        communityId: s.community_id,
+        actorId: 'system',
+        kind: 'monthly',
+        period,
+      })
+      created += 1
+    } catch {
+      // lingkungan tanpa rumah aktif atau tanpa nominal — lewati diam-diam
+    }
+  }
+  return created
+}
