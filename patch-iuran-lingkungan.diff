+        `SELECT id FROM members
+          WHERE community_id=? AND status='active' AND role='admin'`,
+      )
+      .all(cur.community_id) as { id: string }[]
+    if (admins.length > 0) {
+      void pushToMembers(
+        admins.map((a) => a.id),
+        {
+          title: 'Konfirmasi iuran',
+          body: `${row.house_label} menyatakan sudah membayar (${row.reference}).`,
+          url: '#/app/iuran',
+          tag: 'dues-claim',
+        },
+      )
+    }
+    return c.json({ charge: mapCharge(row) })
+  } catch (e) {
+    return duesFail(c, e)
+  }
+})
+
+/** Admin menolak klaim; tagihan kembali berstatus belum bayar. */
+app.post('/api/dues/charges/:id/reject', auth, active, async (c) => {
+  if (!requireAdmin(c)) return bad(c, 'adminOnly', 403)
+  const me = c.get('me')
+  const cur = getCharge(c.req.param('id') ?? '')
+  if (!cur || !sameCommunity(me, cur.community_id)) return bad(c, 'forbidden', 403)
+  const b = (await c.req.json().catch(() => ({}))) as { note?: string }
+  try {
+    const row = rejectClaim(cur.id, me.id, b.note ?? '')
+    if (cur.claimed_by) {
+      void pushToMembers([cur.claimed_by], {
+        title: 'Konfirmasi iuran ditolak',
+        body: b.note?.slice(0, 120) || 'Pembayaran belum ditemukan oleh pengurus.',
+        url: '#/app/iuran',
+        tag: 'dues',
+      })
+    }
+    return c.json({ charge: mapCharge(row) })
+  } catch (e) {
+    return duesFail(c, e)
+  }
+})
+
+/** Bebaskan satu rumah dari tagihan tertentu. */
+app.post('/api/dues/charges/:id/waive', auth, active, async (c) => {
+  if (!requireAdmin(c)) return bad(c, 'adminOnly', 403)
+  const me = c.get('me')
+  const cur = getCharge(c.req.param('id') ?? '')
+  if (!cur || !sameCommunity(me, cur.community_id)) return bad(c, 'forbidden', 403)
+  const b = (await c.req.json().catch(() => ({}))) as { note?: string }
+  try {
+    return c.json({ charge: mapCharge(waiveCharge(cur.id, me.id, b.note ?? '')) })
+  } catch (e) {
+    return duesFail(c, e)
+  }
+})
+
+/* ================= tampilan web ================= */
+
+/**
+ * Sajikan hasil build tampilan web bila ada, sehingga satu wadah cukup
+ * untuk API sekaligus aplikasinya (dan keduanya seasal — tidak perlu CORS).
+ *
+ * Kalau folder `dist` tidak ada — misalnya saat pengembangan, ketika Vite
+ * yang menyajikan tampilan — bagian ini dilewati begitu saja.
+ *
+ * Catatan: `WJW_STATIC_DIR` harus relatif terhadap direktori kerja proses.
+ */
+const STATIC_DIR = process.env.WJW_STATIC_DIR ?? './dist'
+const INDEX_HTML = join(STATIC_DIR, 'index.html')
+
+if (existsSync(INDEX_HTML)) {
+  const indexHtml = readFileSync(INDEX_HTML, 'utf8')
+  app.use('/*', serveStatic({ root: STATIC_DIR }))
+  // Aplikasi memakai rute di sisi klien: alamat apa pun yang bukan berkas
+  // dan bukan /api harus tetap membuka index.html.
+  app.get('*', (c) => {
+    if (c.req.path.startsWith('/api/')) return c.json({ error: 'notFound' }, 404)
+    return c.html(indexHtml)
+  })
+  console.log(`[WJW] menyajikan tampilan web dari ${STATIC_DIR}`)
+}
