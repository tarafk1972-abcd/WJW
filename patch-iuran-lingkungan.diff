+
+-- Daftar rumah. Sumber kebenaran untuk "siapa saja yang ditagih",
+-- termasuk rumah yang belum memasang aplikasi.
+CREATE TABLE IF NOT EXISTS houses (
+  id           TEXT PRIMARY KEY,
+  community_id TEXT NOT NULL REFERENCES communities(id) ON DELETE CASCADE,
+  -- nomor/label rumah, mis. "A-12"; unik per lingkungan
+  label        TEXT NOT NULL,
+  head_name    TEXT NOT NULL DEFAULT '',
+  -- nominal khusus rumah ini; NULL = ikut nominal bawaan
+  amount       INTEGER,
+  -- 0 = tidak ditagih (rumah kosong, dibebaskan)
+  active       INTEGER NOT NULL DEFAULT 1,
+  note         TEXT NOT NULL DEFAULT '',
+  created_at   INTEGER NOT NULL,
+  created_by   TEXT NOT NULL DEFAULT ''
+);
+CREATE UNIQUE INDEX IF NOT EXISTS idx_houses_label
+  ON houses(community_id, lower(label));
+
+-- Satu penagihan (rutin bulanan atau insidental).
+CREATE TABLE IF NOT EXISTS dues_bills (
+  id           TEXT PRIMARY KEY,
+  community_id TEXT NOT NULL REFERENCES communities(id) ON DELETE CASCADE,
+  title        TEXT NOT NULL,
+  -- monthly | special
+  kind         TEXT NOT NULL DEFAULT 'monthly',
+  -- 'YYYY-MM' untuk iuran bulanan; kosong untuk insidental
+  period       TEXT NOT NULL DEFAULT '',
+  due_at       INTEGER,
+  created_at   INTEGER NOT NULL,
+  created_by   TEXT NOT NULL
+);
+-- Iuran bulanan hanya boleh sekali per periode.
+CREATE UNIQUE INDEX IF NOT EXISTS idx_bills_period
+  ON dues_bills(community_id, period) WHERE period <> '';
+CREATE INDEX IF NOT EXISTS idx_bills_community
+  ON dues_bills(community_id, created_at DESC);
+
+-- Tagihan satu rumah dalam satu penagihan.
+CREATE TABLE IF NOT EXISTS dues_charges (
+  id           TEXT PRIMARY KEY,
+  bill_id      TEXT NOT NULL REFERENCES dues_bills(id) ON DELETE CASCADE,
+  community_id TEXT NOT NULL REFERENCES communities(id) ON DELETE CASCADE,
+  house_id     TEXT NOT NULL REFERENCES houses(id) ON DELETE CASCADE,
+  -- disalin agar riwayat tetap terbaca bila label rumah diubah
+  house_label  TEXT NOT NULL,
+  amount       INTEGER NOT NULL,
+  -- unpaid → awaiting_verification → paid | waived
+  status       TEXT NOT NULL DEFAULT 'unpaid',
+  -- cash | transfer | qris
+  method       TEXT,
+  -- nomor rujukan yang ditentukan sistem, dipakai saat warga bayar via QRIS
+  reference    TEXT NOT NULL DEFAULT '',
+  note         TEXT NOT NULL DEFAULT '',
+  -- warga yang menekan "saya sudah bayar"
+  claimed_by   TEXT,
+  claimed_at   INTEGER,
+  paid_at      INTEGER,
+  -- admin yang menandai lunas / menyetujui
+  settled_by   TEXT,
+  created_at   INTEGER NOT NULL
+);
+CREATE UNIQUE INDEX IF NOT EXISTS idx_charge_once ON dues_charges(bill_id, house_id);
+CREATE INDEX IF NOT EXISTS idx_charges_community
+  ON dues_charges(community_id, created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_charges_house ON dues_charges(house_id, status);
