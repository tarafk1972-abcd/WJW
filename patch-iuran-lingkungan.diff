-FROM pierrezemb/gostatic
-COPY . /srv/http/
-CMD ["-port","8080","-https-promote", "-enable-logging"]
+# =============================================================
+# Image produksi WJW: satu wadah berisi API + tampilan web.
+#
+# Dibuat dua tahap supaya image akhir tidak memuat perkakas
+# pengembangan (vite, typescript, vitest) — hanya JavaScript siap
+# jalan dan dependensi produksi.
+# =============================================================
+
+# ---------- tahap 1: bangun ----------
+FROM node:22-slim AS build
+WORKDIR /app
+
+# Dependensi lebih dulu, agar lapisan ini ikut cache selama
+# package-lock.json tidak berubah.
+COPY package.json package-lock.json ./
+RUN npm ci
+
+COPY . .
+
+# Tampilan web → dist/ ; server TypeScript → server-dist/
+RUN npm run build && npm run build:server
+
+# ---------- tahap 2: jalankan ----------
+FROM node:22-slim
+WORKDIR /app
+
+ENV NODE_ENV=production
+ENV TZ=Asia/Jakarta
+# Basis data disimpan di volume Fly; lihat [[mounts]] pada fly.toml.
+ENV WJW_DB=/data/wjw.sqlite
+ENV PORT=8080
+
+# Hanya dependensi produksi. better-sqlite3 memakai berkas prebuilt
+# untuk linux-x64 (glibc), jadi tidak perlu kompilator di image ini.
+COPY package.json package-lock.json ./
+RUN npm ci --omit=dev && npm cache clean --force
+
+# Hasil bangunan dari tahap sebelumnya.
+COPY --from=build /app/server-dist ./server-dist
+COPY --from=build /app/dist ./dist
+# db.ts membaca schema.sql dari folder yang sama dengan modulnya.
+COPY --from=build /app/server/schema.sql ./server-dist/schema.sql
+
+# Jangan berjalan sebagai root.
+RUN mkdir -p /data && chown -R node:node /data /app
+USER node
+
+EXPOSE 8080
+CMD ["node", "server-dist/index.js"]
