@@ -0,0 +1,334 @@
+/**
+ * Tes iuran lingkungan lewat API: admin menagih warganya sendiri.
+ *
+ * Fokusnya pada aturan yang kalau salah bisa merugikan warga:
+ *   - warga tidak boleh membuat/menandai lunas tagihan
+ *   - warga hanya melihat tagihan rumahnya sendiri
+ *   - nominal per rumah bisa berbeda
+ *   - iuran bulanan tidak boleh dobel dalam satu periode
+ */
+import { mkdtempSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join as pathJoin } from 'node:path'
+import { beforeAll, describe, expect, it } from 'vitest'
+
+let app: { fetch: (r: Request) => Response | Promise<Response> }
+
+beforeAll(async () => {
+  process.env.WJW_DB = pathJoin(mkdtempSync(pathJoin(tmpdir(), 'wjw-dues-')), 't.sqlite')
+  process.env.WJW_NO_LISTEN = '1'
+  process.env.WJW_SUPERADMIN_PASSWORD = 'super-secret'
+  app = (await import('./index.js')).app
+})
+
+async function call(m: string, p: string, b?: unknown, t?: string) {
+  const r = await app.fetch(
+    new Request('http://x' + p, {
+      method: m,
+      headers: {
+        'content-type': 'application/json',
+        ...(t ? { Authorization: `Bearer ${t}` } : {}),
+      },
+      body: b === undefined ? undefined : JSON.stringify(b),
+    }),
+  )
+  const x = await r.text()
+  return { status: r.status, body: x ? JSON.parse(x) : null }
+}
+
+let seq = 0
+
+async function makeAdmin() {
+  seq += 1
+  const r = await call('POST', '/api/auth/register', {
+    name: `Ketua${seq}`,
+    phone: `0817${String(seq).padStart(9, '0')}`,
+    email: `dues-admin${seq}@x.id`,
+    password: 'secret123',
+    house: 'A1',
+    mode: 'create',
+    communityName: `RW Iuran ${seq}`,
+  })
+  if (!r.body?.token) throw new Error(`makeAdmin gagal: ${JSON.stringify(r.body)}`)
+  return {
+    token: r.body.token as string,
+    id: r.body.member.id as string,
+    communityId: r.body.member.communityId as string,
+  }
+}
+
+/** Daftarkan warga di rumah tertentu lalu setujui sebagai warga. */
+async function makeWarga(communityId: string, house: string, adminToken: string) {
+  seq += 1
+  const email = `dues-warga${seq}@x.id`
+  const r = await call('POST', '/api/auth/register', {
+    name: `Warga${seq}`,
+    phone: `0823${String(seq).padStart(9, '0')}`,
+    email,
+    password: 'secret123',
+    house,
+    mode: 'join',
+    communityId,
+  })
+  const id = r.body.member.id as string
+  await call(
+    'POST',
+    `/api/members/${id}/decide`,
+    { decision: 'accept', role: 'warga' },
+    adminToken,
+  )
+  const login = await call('POST', '/api/auth/login', {
+    identifier: email,
+    password: 'secret123',
+  })
+  return { id, house, token: login.body.token as string }
+}
+
+/** Lingkungan siap pakai: admin + 2 rumah + nominal iuran. */
+async function setup(amount = 50_000) {
+  const a = await makeAdmin()
+  const w1 = await makeWarga(a.communityId, 'B1', a.token)
+  const w2 = await makeWarga(a.communityId, 'B2', a.token)
+  await call('POST', '/api/dues/settings', { amount }, a.token)
+  await call('POST', '/api/dues/houses/sync', {}, a.token)
+  return { a, w1, w2 }
+}
+
+describe('daftar rumah', () => {
+  it('mengambil rumah dari nomor rumah yang diisi warga saat mendaftar', async () => {
+    const a = await makeAdmin()
+    await makeWarga(a.communityId, 'C1', a.token)
+    await makeWarga(a.communityId, 'C2', a.token)
+
+    const sync = await call('POST', '/api/dues/houses/sync', {}, a.token)
+    // A1 (admin) + C1 + C2
+    expect(sync.body.added).toBe(3)
+
+    // dipanggil dua kali tidak menggandakan
+    const again = await call('POST', '/api/dues/houses/sync', {}, a.token)
+    expect(again.body.added).toBe(0)
+  })
+
+  it('menandai rumah yang belum memasang aplikasi', async () => {
+    const { a } = await setup()
+    await call('POST', '/api/dues/houses', { label: 'B9', headName: 'Pak Ateng' }, a.token)
+
+    const r = await call('GET', '/api/dues', undefined, a.token)
+    const b9 = r.body.houses.find((h: { label: string }) => h.label === 'B9')
+    const b1 = r.body.houses.find((h: { label: string }) => h.label === 'B1')
+    expect(b9.hasApp).toBe(false)
+    expect(b1.hasApp).toBe(true)
+    expect(r.body.housesWithoutApp).toBe(1)
+  })
+
+  it('menolak nomor rumah kembar', async () => {
+    const { a } = await setup()
+    const r = await call('POST', '/api/dues/houses', { label: 'b1' }, a.token)
+    expect(r.status).toBe(400)
+    expect(r.body.error).toBe('houseExists')
+  })
+
+  it('warga tidak boleh menambah rumah', async () => {
+    const { a, w1 } = await setup()
+    void a
+    const r = await call('POST', '/api/dues/houses', { label: 'Z9' }, w1.token)
+    expect(r.status).toBe(403)
+  })
+})
+
+describe('membuat tagihan', () => {
+  it('menagih semua rumah aktif sesuai nominal bawaan', async () => {
+    const { a } = await setup(50_000)
