+-- Pengaturan iuran per lingkungan.
+CREATE TABLE IF NOT EXISTS dues_settings (
+  community_id   TEXT PRIMARY KEY REFERENCES communities(id) ON DELETE CASCADE,
+  -- nominal bawaan tiap rumah (Rupiah); rumah bisa menimpanya
+  amount         INTEGER NOT NULL DEFAULT 0,
+  -- 1 = sistem membuat tagihan rutin tiap awal bulan
+  auto_monthly   INTEGER NOT NULL DEFAULT 0,
+  -- tanggal jatuh tempo tiap bulan (1-28)
+  due_day        INTEGER NOT NULL DEFAULT 10,
