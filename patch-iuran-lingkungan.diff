diff --git a/src/pages/Dues.tsx b/src/pages/Dues.tsx
new file mode 100644
index 0000000..f2abb30
--- /dev/null
+++ b/src/pages/Dues.tsx
@@ -0,0 +1,774 @@
+/**
+ * Iuran lingkungan.
+ *
+ * Satu halaman, dua wajah:
+ *   - Admin  : atur nominal, kelola daftar rumah, buat tagihan, tandai lunas.
+ *   - Warga  : lihat tagihan rumahnya dan konfirmasi kalau sudah bayar.
+ *
+ * Yang ditagih adalah RUMAH. Semua akun di rumah yang sama melihat tagihan
+ * yang sama, jadi cukup satu HP per rumah untuk bisa ditagih — sisanya
+ * boleh ikut memantau.
+ */
+import { useCallback, useEffect, useState } from 'react'
+import { useNavigate } from 'react-router'
+import {
+  ApiError,
+  duesApi,
+  type ChargeDto,
+  type ChargeStatus,
+  type DuesAdminView,
+  type DuesView,
+  type DuesWargaView,
+  type HouseDto,
+} from '../lib/api'
+import { fmtDate, fmtMoney } from '../lib/format'
+import { useApp } from '../lib/store'
+import { apiMode } from '../lib/sync'
+import { Icon } from '../ui/Icon'
+import { Sheet } from '../ui/Sheet'
+import { useToast } from '../ui/Toast'
+import type { Key } from '../lib/i18n'
+
+const STATUS_KEY: Record<ChargeStatus, Key> = {
+  unpaid: 'duesStatusUnpaid',
+  awaiting_verification: 'duesStatusAwaiting',
+  paid: 'duesStatusPaid',
+  waived: 'duesStatusWaived',
+}
+
+const STATUS_CHIP: Record<ChargeStatus, string> = {
+  unpaid: 'chip-warn',
+  awaiting_verification: 'chip-info',
+  paid: 'chip-brand',
+  waived: 'chip-purple',
+}
+
+export default function Dues() {
+  const { me, community, t, lang } = useApp()
+  const nav = useNavigate()
+  const toast = useToast()
+
+  const [view, setView] = useState<DuesView | null>(null)
+  const [busy, setBusy] = useState(false)
+
+  const load = useCallback(async () => {
+    if (!apiMode()) return
+    try {
+      setView(await duesApi.fetch())
+    } catch {
+      setView(null)
+    }
+  }, [])
+
+  useEffect(() => {
+    void load()
+  }, [load])
+
+  /** Bungkus aksi: kunci tombol, tampilkan pesan, lalu muat ulang. */
+  const run = async (fn: () => Promise<unknown>, okKey?: Key, vars?: Record<string, string | number>) => {
+    setBusy(true)
+    try {
+      await fn()
+      await load()
+      if (okKey) toast(t(okKey, vars))
+    } catch (e) {
+      toast(t((e instanceof ApiError ? e.code : 'errUnknown') as Key), 'err')
+    }
+    setBusy(false)
+  }
+
+  if (!me || !community) return null
+
+  return (
+    <div className="page">
+      <div className="row" style={{ marginBottom: 14 }}>
+        <button className="icon-btn" onClick={() => nav(-1)}>
+          <Icon name="chevronLeft" size={18} />
+        </button>
+        <h2 className="grow" style={{ fontSize: 20, fontWeight: 800 }}>
+          {t('dues')}
+        </h2>
+      </div>
+
+      {!apiMode() ? (
+        <div className="banner banner-info">
+          <Icon name="info" size={17} />
+          <span>{t('duesNeedServer')}</span>
+        </div>
+      ) : !view ? (
+        <div className="empty">
+          <span className="em">💰</span>
+          {t('loading')}
+        </div>
+      ) : view.admin ? (
+        <AdminView v={view} t={t} lang={lang} busy={busy} run={run} reload={load} />
+      ) : (
+        <WargaView v={view} t={t} lang={lang} busy={busy} run={run} />
+      )}
+    </div>
+  )
+}
+
+/* ---------------- tampilan warga ---------------- */
+
+function WargaView({
+  v,
+  t,
+  lang,
+  busy,
+  run,
+}: {
+  v: DuesWargaView
+  t: (k: Key, vars?: Record<string, string | number>) => string
+  lang: 'id' | 'en' | 'su'
+  busy: boolean
+  run: (fn: () => Promise<unknown>, okKey?: Key) => Promise<void>
+}) {
+  const open = v.charges.find(
+    (c) => c.status === 'unpaid' || c.status === 'awaiting_verification',
+  )
+
+  if (!v.house) {
+    return (
+      <div className="banner banner-warn">
+        <Icon name="info" size={17} />
+        <span>{t('duesNoHouseForMe')}</span>
+      </div>
+    )
+  }
+
+  return (
+    <>
+      <p className="muted" style={{ marginTop: 0 }}>
+        {t('duesWargaIntro')} · {v.house.label}
+      </p>
+
+      {open ? (
+        <div
+          className="card"
+          style={{
+            borderColor:
+              open.status === 'awaiting_verification' ? 'var(--info)' : 'var(--warn)',
+          }}
+        >
+          <div className="row-between" style={{ marginBottom: 8 }}>
+            <span className="strong">{fmtMoney(open.amount, lang)}</span>
+            <span className={`chip ${STATUS_CHIP[open.status]}`}>
+              {t(STATUS_KEY[open.status])}
+            </span>
+          </div>
+
+          <div className="tiny">
+            {t('duesRef')}: {open.reference}
+          </div>
+
+          {v.payInfo && (
+            <p className="tiny" style={{ marginTop: 8 }}>
+              {v.payInfo}
+            </p>
+          )}
+          {v.qrisImage && (
+            <img
+              src={v.qrisImage}
+              alt="QRIS"
+              style={{ width: '100%', borderRadius: 12, marginTop: 10 }}
+            />
+          )}
+
+          {open.status === 'unpaid' ? (
+            <button
+              className="btn btn-primary"
+              style={{ marginTop: 12 }}
+              disabled={busy}
+              onClick={() => void run(() => duesApi.claim(open.id), 'duesClaimSent')}
+            >
+              <Icon name="check" size={16} /> {t('duesIPaid')}
+            </button>
+          ) : (
+            <p className="tiny center" style={{ marginTop: 10 }}>
+              {t('duesClaimNote')}
+            </p>
+          )}
+        </div>
+      ) : (
+        <div className="empty">
+          <span className="em">🎉</span>
+          {t('duesNoBillsForMe')}
+        </div>
+      )}
+
+      <div className="section-title">{t('duesBills')}</div>
+      {v.charges.length === 0 ? (
+        <div className="empty">
+          <span className="em">🧾</span>
+          {t('duesNoBills')}
+        </div>
+      ) : (
+        v.charges.map((c) => <ChargeRow key={c.id} c={c} t={t} lang={lang} />)
+      )}
+    </>
+  )
+}
+
+function ChargeRow({
+  c,
+  t,
+  lang,
+}: {
+  c: ChargeDto
+  t: (k: Key) => string
+  lang: 'id' | 'en' | 'su'
+}) {
+  return (
+    <div className="item">
+      <div
+        className="item-icon"
+        style={{
+          background: c.status === 'paid' ? 'var(--brand-soft)' : 'var(--surface-2)',
+          color: c.status === 'paid' ? 'var(--brand)' : 'var(--text-2)',
+        }}
+      >
+        <Icon name="credit" size={18} />
+      </div>
+      <div className="grow">
+        <div className="strong">{fmtMoney(c.amount, lang)}</div>
+        <div className="tiny">{fmtDate(c.createdAt, lang)}</div>
+      </div>
+      <span className={`chip ${STATUS_CHIP[c.status]}`}>{t(STATUS_KEY[c.status])}</span>
+    </div>
+  )
+}
+
+/* ---------------- tampilan admin ---------------- */
+
+function AdminView({
+  v,
+  t,
+  lang,
+  busy,
+  run,
+  reload,
+}: {
+  v: DuesAdminView
+  t: (k: Key, vars?: Record<string, string | number>) => string
+  lang: 'id' | 'en' | 'su'
+  busy: boolean
+  run: (
+    fn: () => Promise<unknown>,
+    okKey?: Key,
+    vars?: Record<string, string | number>,
+  ) => Promise<void>
+  reload: () => Promise<void>
+}) {
+  const toast = useToast()
+  const [tab, setTab] = useState<'bill' | 'houses' | 'settings'>('bill')
+  const [editing, setEditing] = useState<HouseDto | null>(null)
+  const [adding, setAdding] = useState(false)
+  const [special, setSpecial] = useState(false)
+
+  const s = v.current?.summary
+
+  return (
+    <>
+      <p className="muted" style={{ marginTop: 0 }}>
+        {t('duesAdminIntro')}
+      </p>
+
+      {/* ringkasan penagihan terakhir */}
+      {v.current && s && (
+        <div
+          className="card"
+          style={{
+            background: 'linear-gradient(135deg, rgba(46,194,126,.16), var(--surface))',
+          }}
+        >
+          <div className="row-between">
+            <div>
+              <div className="tiny">{v.bills[0]?.title}</div>
+              <div style={{ fontSize: 22, fontWeight: 900, letterSpacing: -0.5 }}>
+                {fmtMoney(s.collected, lang)}
+              </div>
+              <div className="muted" style={{ marginTop: 2 }}>
+                {t('duesCollected')} · {t('duesPaidCount', { paid: s.paid, total: s.houses })}
+              </div>
+            </div>
+            <Icon name="chart" size={30} color="var(--brand)" />
+          </div>
+          {s.billed - s.collected > 0 && (
+            <div className="tiny" style={{ marginTop: 8 }}>
+              {t('duesOutstanding')}: {fmtMoney(s.billed - s.collected, lang)}
+              {s.awaiting > 0 && ` · ${s.awaiting} ${t('duesStatusAwaiting').toLowerCase()}`}
+            </div>
+          )}
+        </div>
+      )}
+
+      {/* rumah yang belum memasang aplikasi */}
+      {v.housesWithoutApp > 0 && (
+        <div className="banner banner-warn" style={{ marginTop: 12 }}>
+          <Icon name="info" size={17} />
+          <span>{t('duesNoAppNote', { n: v.housesWithoutApp })}</span>
+        </div>
+      )}
+
+      <div className="btn-row" style={{ marginTop: 14 }}>
+        <button
+          className={`btn btn-sm ${tab === 'bill' ? 'btn-primary' : 'btn-ghost'}`}
+          onClick={() => setTab('bill')}
+        >
+          {t('duesShort')}
+        </button>
+        <button
+          className={`btn btn-sm ${tab === 'houses' ? 'btn-primary' : 'btn-ghost'}`}
+          onClick={() => setTab('houses')}
+        >
+          {t('duesHouses')}
+        </button>
+        <button
+          className={`btn btn-sm ${tab === 'settings' ? 'btn-primary' : 'btn-ghost'}`}
+          onClick={() => setTab('settings')}
+        >
+          {t('duesSettings')}
+        </button>
+      </div>
+
+      {tab === 'bill' && (
+        <>
+          <div className="btn-row" style={{ marginTop: 12 }}>
+            <button
+              className="btn btn-primary"
+              disabled={busy}
+              onClick={() =>
+                void run(() => duesApi.createBill({ kind: 'monthly' }), 'duesBillCreated', {
+                  n: v.houses.filter((h) => h.active).length,
+                })
+              }
+            >
+              <Icon name="plus" size={16} /> {t('duesCreateMonthly')}
+            </button>
+            <button className="btn btn-ghost" onClick={() => setSpecial(true)}>
+              <Icon name="gift" size={16} /> {t('duesCreateSpecial')}
+            </button>
+          </div>
+
+          <div className="section-title">{t('duesShort')}</div>
+          {!v.current || v.current.charges.length === 0 ? (
+            <div className="empty">
+              <span className="em">🧾</span>
+              {t('duesNoBills')}
+            </div>
+          ) : (
+            v.current.charges.map((c) => (
+              <AdminCharge key={c.id} c={c} t={t} lang={lang} busy={busy} run={run} />
+            ))
+          )}
+
+          {v.bills.length > 1 && (
+            <>
+              <div className="section-title">{t('duesBills')}</div>
+              {v.bills.slice(1).map((b) => (
+                <div key={b.id} className="item">
+                  <div
+                    className="item-icon"
+                    style={{ background: 'var(--surface-2)', color: 'var(--text-2)' }}
+                  >
+                    <Icon name="clipboard" size={18} />
+                  </div>
+                  <div className="grow">
+                    <div className="strong">{b.title}</div>
+                    <div className="tiny">{fmtDate(b.createdAt, lang)}</div>
+                  </div>
+                </div>
+              ))}
+            </>
+          )}
+        </>
+      )}
+
+      {tab === 'houses' && (
+        <>
+          <div className="btn-row" style={{ marginTop: 12 }}>
+            <button className="btn btn-primary" onClick={() => setAdding(true)}>
+              <Icon name="plus" size={16} /> {t('duesAddHouse')}
+            </button>
+            <button
+              className="btn btn-ghost"
+              disabled={busy}
+              onClick={async () => {
+                try {
+                  const r = await duesApi.syncHouses()
+                  await reload()
+                  toast(t('duesSynced', { n: r.added }))
+                } catch {
+                  toast(t('errUnknown'), 'err')
+                }
+              }}
+            >
+              <Icon name="users" size={16} /> {t('duesSyncHouses')}
+            </button>
+          </div>
+
+          <div className="section-title">
+            {t('duesHouseCount', { n: v.houses.length })}
+          </div>
+          {v.houses.length === 0 ? (
+            <div className="empty">
+              <span className="em">🏠</span>
+              {t('duesNoHouses')}
+            </div>
+          ) : (
+            v.houses.map((h) => (
+              <button key={h.id} className="item" onClick={() => setEditing(h)}>
+                <div
+                  className="item-icon"
+                  style={{
+                    background: h.hasApp ? 'var(--brand-soft)' : 'var(--warn-soft)',
+                    color: h.hasApp ? 'var(--brand)' : 'var(--warn)',
+                  }}
+                >
+                  <Icon name="home" size={18} />
+                </div>
+                <div className="grow" style={{ textAlign: 'left' }}>
+                  <div className="strong">
+                    {h.label}
+                    {h.headName ? ` · ${h.headName}` : ''}
+                  </div>
+                  <div className="tiny">
+                    {fmtMoney(h.effectiveAmount, lang)}
+                    {!h.active ? ` · ${t('duesHouseInactive')}` : ''}
+                    {!h.hasApp ? ` · ${t('duesNoApp')}` : ''}
+                  </div>
+                </div>
+                <Icon name="chevronRight" size={16} color="var(--text-3)" />
+              </button>
+            ))
+          )}
+        </>
+      )}
+
+      {tab === 'settings' && <SettingsTab v={v} t={t} busy={busy} run={run} />}
+
+      <HouseSheet
+        open={adding || !!editing}
+        house={editing}
+        t={t}
+        busy={busy}
+        run={run}
+        onClose={() => {
+          setAdding(false)
+          setEditing(null)
+        }}
+      />
+
+      <SpecialSheet
+        open={special}
+        t={t}
+        busy={busy}
+        run={run}
+        onClose={() => setSpecial(false)}
+      />
+    </>
+  )
+}
+
+function AdminCharge({
+  c,
+  t,
+  lang,
+  busy,
+  run,
+}: {
+  c: ChargeDto
+  t: (k: Key, vars?: Record<string, string | number>) => string
+  lang: 'id' | 'en' | 'su'
+  busy: boolean
+  run: (fn: () => Promise<unknown>, okKey?: Key) => Promise<void>
+}) {
+  return (
+    <div className="item">
+      <div
+        className="item-icon"
+        style={{
+          background:
+            c.status === 'paid'
+              ? 'var(--brand-soft)'
+              : c.status === 'awaiting_verification'
+                ? 'var(--info-soft)'
+                : 'var(--warn-soft)',
+          color:
+            c.status === 'paid'
+              ? 'var(--brand)'
+              : c.status === 'awaiting_verification'
+                ? 'var(--info)'
+                : 'var(--warn)',
+        }}
+      >
+        <Icon name="home" size={18} />
+      </div>
+      <div className="grow">
+        <div className="strong">
+          {c.house} · {fmtMoney(c.amount, lang)}
+        </div>
+        <div className="tiny">
+          {t(STATUS_KEY[c.status])}
+          {c.status === 'awaiting_verification' ? ` · ${c.reference}` : ''}
+        </div>
+      </div>
+      {c.status !== 'paid' && c.status !== 'waived' && (
+        <button
+          className="btn btn-sm btn-primary btn-auto"
+          disabled={busy}
+          onClick={() => void run(() => duesApi.markPaid(c.id))}
+        >
+          <Icon name="check" size={14} />
+        </button>
+      )}
+    </div>
+  )
+}
+
+function SettingsTab({
+  v,
+  t,
+  busy,
+  run,
+}: {
+  v: DuesAdminView
+  t: (k: Key, vars?: Record<string, string | number>) => string
+  busy: boolean
+  run: (fn: () => Promise<unknown>, okKey?: Key) => Promise<void>
+}) {
+  const [amount, setAmount] = useState(String(v.settings.amount || ''))
+  const [dueDay, setDueDay] = useState(String(v.settings.dueDay))
+  const [payInfo, setPayInfo] = useState(v.settings.payInfo)
+  const [auto, setAuto] = useState(v.settings.autoMonthly)
+
+  return (
+    <div className="card" style={{ marginTop: 12 }}>
+      <label className="field">
+        <span>{t('duesAmount')}</span>
+        <input
+          className="input"
+          inputMode="numeric"
+          value={amount}
+          onChange={(e) => setAmount(e.target.value.replace(/\D/g, ''))}
+          placeholder="50000"
+        />
+      </label>
+      <p className="tiny">{t('duesAmountHint')}</p>
+
+      <label className="field">
+        <span>{t('duesDueDay')}</span>
+        <input
+          className="input"
+          inputMode="numeric"
+          value={dueDay}
+          onChange={(e) => setDueDay(e.target.value.replace(/\D/g, ''))}
+          placeholder="10"
+        />
+      </label>
+
+      <label className="field">
+        <span>{t('duesPayInfo')}</span>
+        <textarea
+          className="input"
+          rows={3}
+          value={payInfo}
+          onChange={(e) => setPayInfo(e.target.value)}
+          placeholder={t('duesPayInfoHint')}
+        />
+      </label>
+
+      <button
+        className={`btn btn-sm ${auto ? 'btn-primary' : 'btn-ghost'}`}
+        onClick={() => setAuto(!auto)}
+      >
+        <Icon name={auto ? 'check' : 'clock'} size={15} /> {t('duesAuto')}
+      </button>
+
+      <button
+        className="btn btn-primary"
+        style={{ marginTop: 12 }}
+        disabled={busy}
+        onClick={() =>
+          void run(
+            () =>
+              duesApi.saveSettings({
+                amount: Number(amount || 0),
+                dueDay: Number(dueDay || 10),
+                payInfo,
+                autoMonthly: auto,
+              }),
+            'duesSettingsSaved',
+          )
+        }
+      >
+        <Icon name="check" size={16} /> {t('save')}
+      </button>
+    </div>
+  )
+}
+
+function HouseSheet({
+  open,
+  house,
+  t,
+  busy,
+  run,
+  onClose,
+}: {
+  open: boolean
+  house: HouseDto | null
+  t: (k: Key, vars?: Record<string, string | number>) => string
+  busy: boolean
+  run: (fn: () => Promise<unknown>, okKey?: Key) => Promise<void>
+  onClose: () => void
+}) {
+  const [label, setLabel] = useState('')
+  const [head, setHead] = useState('')
+  const [amount, setAmount] = useState('')
+
+  // Isi ulang tiap kali rumah yang disunting berganti.
+  useEffect(() => {
+    setLabel(house?.label ?? '')
+    setHead(house?.headName ?? '')
+    setAmount(house?.amount == null ? '' : String(house.amount))
+  }, [house, open])
+
+  const save = async () => {
+    const patch = {
+      label,
+      headName: head,
+      amount: amount === '' ? null : Number(amount),
+    }
+    await run(
+      () => (house ? duesApi.updateHouse(house.id, patch) : duesApi.addHouse(patch)),
+      'duesHouseSaved',
+    )
+    onClose()
+  }
+
+  return (
+    <Sheet open={open} onClose={onClose} title={house ? house.label : t('duesAddHouse')}>
+      <label className="field">
+        <span>{t('duesHouseLabel')}</span>
+        <input
+          className="input"
+          value={label}
+          onChange={(e) => setLabel(e.target.value)}
+          placeholder="A-12"
+        />
+      </label>
+      <label className="field">
+        <span>{t('duesHouseHead')}</span>
+        <input
+          className="input"
+          value={head}
+          onChange={(e) => setHead(e.target.value)}
+        />
+      </label>
+      <label className="field">
+        <span>{t('duesHouseAmount')}</span>
+        <input
+          className="input"
+          inputMode="numeric"
+          value={amount}
+          onChange={(e) => setAmount(e.target.value.replace(/\D/g, ''))}
+        />
+      </label>
+
+      <button className="btn btn-primary" disabled={busy || !label} onClick={() => void save()}>
+        <Icon name="check" size={16} /> {t('save')}
+      </button>
+
+      {house && (
+        <>
+          <button
+            className="btn btn-ghost"
+            style={{ marginTop: 8 }}
+            disabled={busy}
+            onClick={() =>
+              void run(() => duesApi.updateHouse(house.id, { active: !house.active })).then(
+                onClose,
+              )
+            }
+          >
+            <Icon name={house.active ? 'eyeOff' : 'eye'} size={15} />{' '}
+            {house.active ? t('duesHouseInactive') : t('duesShort')}
+          </button>
+          <button
+            className="btn btn-danger"
+            style={{ marginTop: 8 }}
+            disabled={busy}
+            onClick={() => {
+              if (!confirm(t('duesHouseRemoveConfirm'))) return
+              void run(() => duesApi.removeHouse(house.id), 'duesHouseRemoved').then(onClose)
+            }}
+          >
+            <Icon name="trash" size={15} /> {t('delete')}
+          </button>
+        </>
+      )}
+    </Sheet>
+  )
+}
+
+function SpecialSheet({
+  open,
+  t,
+  busy,
+  run,
+  onClose,
+}: {
+  open: boolean
+  t: (k: Key, vars?: Record<string, string | number>) => string
+  busy: boolean
+  run: (fn: () => Promise<unknown>, okKey?: Key) => Promise<void>
+  onClose: () => void
+}) {
+  const [title, setTitle] = useState('')
+  const [amount, setAmount] = useState('')
+
+  return (
+    <Sheet open={open} onClose={onClose} title={t('duesCreateSpecial')}>
+      <label className="field">
+        <span>{t('duesBillTitle')}</span>
+        <input
+          className="input"
+          value={title}
+          onChange={(e) => setTitle(e.target.value)}
+          placeholder={t('duesBillTitleHint')}
+        />
+      </label>
+      <label className="field">
+        <span>{t('duesAmount')}</span>
+        <input
+          className="input"
+          inputMode="numeric"
+          value={amount}
+          onChange={(e) => setAmount(e.target.value.replace(/\D/g, ''))}
+        />
+      </label>
+      <button
+        className="btn btn-primary"
+        disabled={busy || !title || !amount}
+        onClick={() => {
+          void run(
+            () =>
+              duesApi.createBill({
+                kind: 'special',
+                title,
+                amount: Number(amount),
+              }),
+          ).then(() => {
+            setTitle('')
+            setAmount('')
+            onClose()
+          })
+        }}
+      >
+        <Icon name="check" size={16} /> {t('duesCreateBill')}
+      </button>
+    </Sheet>
+  )
+}
