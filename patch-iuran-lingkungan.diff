diff --git a/scripts/ambil-rahasia-fly.sh b/scripts/ambil-rahasia-fly.sh
new file mode 100755
index 0000000..178dad4
--- /dev/null
+++ b/scripts/ambil-rahasia-fly.sh
@@ -0,0 +1,88 @@
+#!/usr/bin/env bash
+#
+# Mengambil nilai rahasia dari app Fly yang sedang berjalan, lalu menuliskannya
+# ke rahasia.env.
+#
+# Kenapa perlu: Fly TIDAK BISA menampilkan kembali nilai rahasia. `fly secrets
+# list` hanya memperlihatkan sidik jarinya, bukan isinya. Tapi rahasia itu
+# disuntikkan sebagai variabel lingkungan ke dalam mesin yang berjalan, jadi
+# kita bisa membacanya dari dalam.
+#
+# Pakai:  bash scripts/ambil-rahasia-fly.sh
+#
+set -euo pipefail
+
+LAMA="${LAMA:-warga-jaga-warga-wjw}"
+KELUARAN="${KELUARAN:-rahasia.env}"
+
+# Yang perlu ikut pindah. TZ / WJW_DB / PORT / NODE_ENV sengaja TIDAK diambil —
+# semuanya sudah ditulis di fly.toml dan Dockerfile. WJW_APP_URL juga tidak,
+# karena harus berubah mengikuti alamat baru.
+NAMA=(
+  WJW_SUPERADMIN_PASSWORD
+  VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY VAPID_SUBJECT
+  SMTP_HOST SMTP_PORT SMTP_USER SMTP_PASS MAIL_FROM MAIL_REPLY_TO
+  WJW_QRIS_NAME WJW_QRIS_PHONE WJW_QRIS_IMAGE_URL WJW_PAYMENT_INFO
+  WJW_PRICE_MONTHLY WJW_PRICE_YEARLY WJW_INVOICE_DAYS
+  WJW_RATE_LOGIN_MAX WJW_RATE_REGISTER_MAX
+)
+
+merah() { printf '\033[31m%s\033[0m\n' "$*"; }
+hijau() { printf '\033[32m%s\033[0m\n' "$*"; }
+kuning() { printf '\033[33m%s\033[0m\n' "$*"; }
+
+command -v fly >/dev/null 2>&1 || { merah "flyctl belum terpasang."; exit 1; }
+fly auth whoami >/dev/null 2>&1 || { merah "belum login. Jalankan: fly auth login"; exit 1; }
+
+if [ -e "$KELUARAN" ]; then
+  merah "$KELUARAN sudah ada. Pindahkan atau hapus dulu supaya tidak tertimpa."
+  exit 1
+fi
+
+echo "Membaca variabel lingkungan dari mesin $LAMA ..."
+MENTAH=$(mktemp)
+trap 'rm -f "$MENTAH"' EXIT
+
+# printenv dijalankan di dalam mesin; satu sambungan untuk semua nilai.
+fly ssh console -a "$LAMA" -C "printenv" >"$MENTAH" 2>/dev/null || {
+  merah "gagal menyambung ke mesin. Pastikan app $LAMA sedang menyala:"
+  merah "  fly scale count 1 -a $LAMA"
+  exit 1
+}
+
+# Berkas rahasia harus lahir tertutup, bukan ditutup belakangan.
+umask 077
+: >"$KELUARAN"
+
+ADA=0
+HILANG=()
+for n in "${NAMA[@]}"; do
+  baris=$(grep -m1 "^$n=" "$MENTAH" || true)
+  if [ -n "$baris" ] && [ "$baris" != "$n=" ]; then
+    printf '%s\n' "$baris" >>"$KELUARAN"
+    ADA=$((ADA + 1))
+  else
+    HILANG+=("$n")
+  fi
+done
+
+hijau "$ADA nilai tersimpan ke $KELUARAN (hak akses 600)"
+
+if [ ${#HILANG[@]} -gt 0 ]; then
+  kuning "Tidak diset di app lama (wajar kalau memang belum dipakai):"
+  printf '  - %s\n' "${HILANG[@]}"
+fi
+
+if ! grep -q '^VAPID_PRIVATE_KEY=' "$KELUARAN"; then
+  merah ""
+  merah "PENTING: VAPID_PRIVATE_KEY tidak ketemu."
+  merah "Tanpa itu notifikasi push mati untuk semua warga setelah pindah."
+  merah "Jangan lanjut ke pindah-app-fly.sh sebelum ini beres."
+  exit 1
+fi
+
+echo
+kuning "Periksa isinya sebentar, lalu lanjut:"
+kuning "  bash scripts/pindah-app-fly.sh"
+kuning ""
+kuning "Jangan pernah commit atau kirim $KELUARAN lewat WhatsApp/email."
diff --git a/scripts/pindah-app-fly.sh b/scripts/pindah-app-fly.sh
new file mode 100755
index 0000000..4226fa3
--- /dev/null
+++ b/scripts/pindah-app-fly.sh
@@ -0,0 +1,275 @@
+#!/usr/bin/env bash
+#
+# Pindah aplikasi WJW ke nama app Fly yang baru — dua fase.
+#
+# Fly.io tidak bisa mengganti nama app, jadi ini "pindah rumah".
+#
+#   Fase 1 (coba)   : app baru dibuat & di-deploy dengan basis data KOSONG.
+#                     App lama tetap melayani warga. Tanpa risiko sama sekali.
+#                     Di sini ketahuan apakah Dockerfile & kode baru benar.
+#
+#   Fase 2 (pindah) : basis data asli disalin ke app baru. App lama dimatikan.
+#                     Aplikasi mati sekitar 5-15 menit. App lama TIDAK dihapus.
+#
+# Pakai:
+#   bash scripts/pindah-app-fly.sh coba
+#   bash scripts/pindah-app-fly.sh pindah
+#
+set -euo pipefail
+
+LAMA="${LAMA:-warga-jaga-warga-wjw}"
+BARU="${BARU:-wjw-app}"
+REGION="${REGION:-sin}"
+VOLUME="${VOLUME:-wjw_data}"
+UKURAN_GB="${UKURAN_GB:-1}"
+RAHASIA="${RAHASIA:-rahasia.env}"
+DB="/data/wjw.sqlite"
+
+merah() { printf '\033[31m%s\033[0m\n' "$*"; }
+hijau() { printf '\033[32m%s\033[0m\n' "$*"; }
+kuning() { printf '\033[33m%s\033[0m\n' "$*"; }
+judul() { printf '\n\033[1m== %s ==\033[0m\n' "$*"; }
+
+batal() {
+  merah ""
+  merah "BERHENTI: $*"
+  kuning ""
+  kuning "App lama ($LAMA) tidak dihapus. Kalau layanan sedang mati,"
+  kuning "kembalikan sekarang juga:"
+  kuning "    fly scale count 1 -a $LAMA"
+  exit 1
+}
+
+tanya() {
+  local jawab
+  read -r -p "$1 [ketik YA]: " jawab
+  [ "$jawab" = "YA" ] || batal "dibatalkan pengguna"
+}
+
+sehat() { # $1 = url ; menunggu sampai /api/health menjawab
+  local i
+  for i in $(seq 1 36); do
+    if curl -sf -m 10 "$1/api/health" >/tmp/wjw-health.json 2>/dev/null; then
+      grep -q '"ok":true' /tmp/wjw-health.json && return 0
+    fi
+    printf '.'
+    sleep 5
+  done
+  echo
+  return 1
+}
+
+dasar() {
+  command -v fly >/dev/null 2>&1 || batal "flyctl belum terpasang — https://fly.io/docs/flyctl/install/"
+  fly auth whoami >/dev/null 2>&1 || batal "belum login. Jalankan: fly auth login"
+  [ -f fly.toml ] || batal "jalankan dari folder utama repo WJW (tempat fly.toml berada)"
+  grep -q "^app = \"$BARU\"" fly.toml || batal "fly.toml belum menunjuk '$BARU'"
+}
+
+# =============================================================== FASE 1: COBA
+
+fase_coba() {
+  judul "Fase 1 — mendirikan app baru (app lama tidak disentuh)"
+  dasar
+  hijau "flyctl siap, masuk sebagai $(fly auth whoami)"
+
+  if fly status -a "$BARU" >/dev/null 2>&1; then
+    kuning "app '$BARU' sudah ada — melanjutkan deploy ulang saja"
+  else
+    fly apps create "$BARU" || batal "gagal membuat app $BARU (nama mungkin sudah dipakai orang lain)"
+    hijau "app $BARU dibuat"
+  fi
+
+  if fly volumes list -a "$BARU" 2>/dev/null | grep -q "$VOLUME"; then
+    kuning "volume $VOLUME sudah ada"
+  else
+    fly volumes create "$VOLUME" --size "$UKURAN_GB" --region "$REGION" -a "$BARU" --yes ||
+      batal "gagal membuat volume"
+    hijau "volume $VOLUME dibuat ($UKURAN_GB GB, $REGION)"
+  fi
+
+  judul "Deploy"
+  fly deploy -a "$BARU" || batal "deploy gagal. App lama masih melayani warga seperti biasa — tidak ada yang rusak."
+
+  judul "Memeriksa"
+  sehat "https://$BARU.fly.dev" || batal "app baru tidak menjawab. Lihat sebabnya: fly logs -a $BARU"
+  echo
+  hijau "health: $(cat /tmp/wjw-health.json)"
+  curl -sf -m 10 -o /dev/null "https://$BARU.fly.dev/" || batal "halaman utama tidak terbuka"
+  hijau "halaman utama terbuka"
+
+  judul "Fase 1 selesai"
+  cat <<PESAN
+
+App baru hidup di  https://$BARU.fly.dev  dengan basis data KOSONG.
+App lama masih melayani warga seperti biasa.
+
+Sekarang buka alamat baru itu di HP, lalu coba:
+  [ ] halaman terbuka, tampilan benar
+  [ ] daftar akun uji, lalu login
+  [ ] kirim satu laporan uji
+  [ ] buka menu Iuran lingkungan
+
+Ini semua data buangan — akan tertimpa habis di fase 2.
+
+Kalau ada yang rusak, tidak perlu panik: warga tidak terpengaruh.
+Perbaiki, lalu jalankan ulang perintah yang sama.
+
+Kalau semuanya benar, siapkan rahasianya:
+    bash scripts/ambil-rahasia-fly.sh
+lalu pindahkan datanya:
+    bash scripts/pindah-app-fly.sh pindah
+PESAN
+}
+
+# ============================================================= FASE 2: PINDAH
+
+fase_pindah() {
+  judul "Fase 2 — memindahkan basis data"
+  dasar
+
+  fly status -a "$LAMA" >/dev/null 2>&1 || batal "app lama '$LAMA' tidak ditemukan"
+  fly status -a "$BARU" >/dev/null 2>&1 || batal "app baru belum ada. Jalankan dulu: bash $0 coba"
+
+  [ -f "$RAHASIA" ] || batal "berkas '$RAHASIA' tidak ada. Jalankan dulu: bash scripts/ambil-rahasia-fly.sh"
+  grep -q '^VAPID_PRIVATE_KEY=' "$RAHASIA" ||
+    batal "VAPID_PRIVATE_KEY tidak ada di $RAHASIA — tanpa itu notifikasi darurat mati untuk SEMUA warga"
+  hijau "rahasia siap: $(grep -c '=' "$RAHASIA") nilai"
+
+  kuning ""
+  kuning "Mulai detik ini aplikasi akan MATI untuk semua warga, 5-15 menit."
+  kuning "Pastikan sudah jam sepi dan pengumuman sudah disebar."
+  tanya "Mulai pemindahan?"
+
+  # ---- cadangan ----------------------------------------------------------
+  judul "1/5 Mencadangkan basis data lama"
+  CADANGAN="wjw-backup-$(date +%Y%m%d-%H%M%S).sqlite"
+
+  # .backup menghasilkan satu berkas utuh walau basis data sedang dipakai.
+  # Mesin harus MENYALA untuk ini — ssh dan sftp tidak bisa ke mesin mati.
+  if fly ssh console -a "$LAMA" -C "sqlite3 $DB '.backup /data/_pindah.sqlite'" >/dev/null 2>&1; then
+    hijau "snapshot dibuat dengan sqlite3 .backup"
+    fly sftp get /data/_pindah.sqlite "$CADANGAN" -a "$LAMA" || batal "gagal mengunduh cadangan"
+    fly ssh console -a "$LAMA" -C "rm -f /data/_pindah.sqlite" >/dev/null 2>&1 || true
+  else
+    kuning "sqlite3 tidak ada di dalam image lama — menyalin berkas mentah"
+    kuning "(termasuk -wal, supaya transaksi terakhir tidak hilang)"
+    fly sftp get "$DB" "$CADANGAN" -a "$LAMA" || batal "gagal mengunduh basis data"
+    fly sftp get "$DB-wal" "$CADANGAN-wal" -a "$LAMA" 2>/dev/null || kuning "tidak ada -wal (wajar)"
+  fi
+
+  [ -s "$CADANGAN" ] || batal "berkas cadangan kosong"
+  UKURAN=$(wc -c <"$CADANGAN")
+  [ "$UKURAN" -gt 4096 ] || batal "cadangan cuma $UKURAN byte — terlalu kecil, jangan diteruskan"
+
+  if command -v sqlite3 >/dev/null 2>&1; then
+    HASIL=$(sqlite3 "$CADANGAN" 'PRAGMA integrity_check;' 2>&1 || echo gagal)
+    [ "$HASIL" = "ok" ] || batal "cadangan rusak (integrity_check: $HASIL)"
+    hijau "integrity_check: ok"
+    echo "  Isi cadangan — catat angkanya, nanti dibandingkan:"
+    for t in members reports communities dues_charges; do
+      J=$(sqlite3 "$CADANGAN" "SELECT COUNT(*) FROM $t;" 2>/dev/null || echo "-")
+      printf '    %-16s %s\n' "$t" "$J"
+    done
+  else
+    kuning "sqlite3 tidak ada di komputer ini — isi cadangan tidak bisa diperiksa di sini"
+  fi
+  hijau "cadangan: $CADANGAN ($UKURAN byte)"
+
+  # ---- matikan app lama --------------------------------------------------
+  judul "2/5 Mematikan app lama"
+  fly scale count 0 -a "$LAMA" --yes || batal "gagal mematikan app lama"
+  hijau "$LAMA berhenti — tidak ada lagi data baru masuk ke sana"
+
+  # ---- unggah ------------------------------------------------------------
+  judul "3/5 Mengunggah basis data ke app baru"
+
+  # Mesin baru sengaja DIBIARKAN MENYALA: sftp mustahil ke mesin yang mati.
+  # Berkas diunggah ke nama sementara, lalu ditukar dari dalam mesin.
+  printf 'put %s /data/_masuk.sqlite\n' "$CADANGAN" | fly sftp shell -a "$BARU" ||
+    batal "gagal mengunggah basis data"
+  if [ -f "$CADANGAN-wal" ]; then
+    printf 'put %s /data/_masuk.sqlite-wal\n' "$CADANGAN-wal" | fly sftp shell -a "$BARU" || true
+  fi
+
+  # -wal dan -shm sisa uji coba WAJIB dibuang. Kalau tertinggal, SQLite akan
+  # memutar ulang isinya ke atas basis data baru dan merusaknya.
+  fly ssh console -a "$BARU" -C \
+    "sh -c 'rm -f $DB $DB-wal $DB-shm && mv /data/_masuk.sqlite $DB && if [ -f /data/_masuk.sqlite-wal ]; then mv /data/_masuk.sqlite-wal $DB-wal; fi'" ||
+    batal "gagal memasang basis data di mesin baru"
+  hijau "basis data terpasang, sisa uji coba dihapus"
+
+  # ---- rahasia -----------------------------------------------------------
+  judul "4/5 Memasang rahasia"
+  ARGS=()
+  while IFS= read -r baris; do
+    case "$baris" in '' | \#*) continue ;; esac
+    ARGS+=("$baris")
+  done <"$RAHASIA"
+  ARGS+=("WJW_APP_URL=https://$BARU.fly.dev")
+
+  # Sekali jalan supaya mesin hanya sekali restart — restart inilah yang
+  # membuat server membuka berkas basis data yang baru.
+  fly secrets set -a "$BARU" "${ARGS[@]}" || batal "gagal memasang rahasia"
+  hijau "${#ARGS[@]} rahasia terpasang, mesin restart"
+
+  sleep 10
+  fly apps restart "$BARU" >/dev/null 2>&1 || true
+
+  # ---- verifikasi --------------------------------------------------------
+  judul "5/5 Memeriksa"
+  URL="https://$BARU.fly.dev"
+  sehat "$URL" || batal "app baru tidak sehat. Lihat: fly logs -a $BARU"
+  echo
+  hijau "health: $(cat /tmp/wjw-health.json)"
+
+  if grep -q '"push":true' /tmp/wjw-health.json; then
+    hijau "notifikasi push: aktif"
+  else
+    merah "PERINGATAN: push=false — kunci VAPID tidak terbaca."
+    merah "Tombol panik TIDAK akan membangunkan siapa pun. Periksa VAPID di $RAHASIA."
+  fi
+
+  curl -sf -m 10 -o /dev/null "$URL/" || batal "halaman utama tidak terbuka"
+  hijau "halaman utama terbuka"
+
+  judul "Pindahan selesai — pemeriksaan terakhir ada di tangan Anda"
+  cat <<PESAN
+
+Alamat baru : $URL
+Cadangan    : $CADANGAN   (simpan, jangan dihapus)
+App lama    : $LAMA — berhenti, tapi masih utuh
+
+Buka alamat baru di peramban dan pastikan sendiri:
+  [ ] login superadmin berhasil
+  [ ] jumlah warga sama dengan angka yang dicatat di langkah 1
+  [ ] laporan lama masih ada
+  [ ] riwayat iuran & langganan masih ada
+  [ ] tombol panik dari HP uji benar-benar memunculkan notifikasi
+
+Ada yang salah? Kembalikan layanan lama dalam satu perintah:
+    fly scale count 1 -a $LAMA
+(app lama masih memegang seluruh data sampai detik pemadaman tadi)
+
+Semuanya benar? Beri jeda beberapa hari, baru:
+    fly apps destroy $LAMA
+
+Setelah itu: warga memasang ulang aplikasi dari $URL,
+dan APK Android dibangun ulang (docs/BUAT-APK.md).
+PESAN
+}
+
+case "${1:-}" in
+coba) fase_coba ;;
+pindah) fase_pindah ;;
+*)
+  cat <<PESAN
+Pakai:
+  bash $0 coba      Fase 1 — dirikan & uji app baru. Warga tidak terganggu.
+  bash $0 pindah    Fase 2 — pindahkan data. Aplikasi mati 5-15 menit.
+
+Jalankan 'coba' lebih dulu. Selalu.
+PESAN
+  exit 1
+  ;;
+esac
