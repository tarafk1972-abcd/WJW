+/**
+ * Tes hitungan iuran: periode, jatuh tempo, dan rekap uang.
+ *
+ * Sengaja tanpa basis data supaya bagian paling rawan salah (batas bulan
+ * menurut WIB) bisa diuji cepat.
+ */
+import { describe, expect, it } from 'vitest'
+import {
+  clampAmount,
+  dueDateOf,
+  periodOf,
+  periodTitle,
+  safeDueDay,
+  summarize,
+} from './dues-calc.js'
+
+/** Bantu baca: waktu WIB → epoch. */
+const wib = (s: string) => Date.parse(`${s}+07:00`)
+
+describe('periodOf', () => {
+  it('memakai WIB, bukan UTC', () => {
+    // 1 September 00.30 WIB = 31 Agustus 17.30 UTC — harus tetap September.
+    expect(periodOf(wib('2026-09-01T00:30:00'))).toBe('2026-09')
+    // 31 Agustus 23.59 WIB masih Agustus.
+    expect(periodOf(wib('2026-08-31T23:59:00'))).toBe('2026-08')
+  })
+
+  it('memberi bulan dua digit', () => {
+    expect(periodOf(wib('2026-01-15T08:00:00'))).toBe('2026-01')
+    expect(periodOf(wib('2026-12-15T08:00:00'))).toBe('2026-12')
+  })
+})
+
+describe('periodTitle', () => {
+  it('memakai nama bulan Indonesia', () => {
+    expect(periodTitle('2026-09')).toBe('Iuran September 2026')
+    expect(periodTitle('2026-01')).toBe('Iuran Januari 2026')
+  })
+})
+
+describe('safeDueDay', () => {
+  it('menjaga tanggal tetap ada di semua bulan', () => {
+    expect(safeDueDay(31)).toBe(28)
+    expect(safeDueDay(0)).toBe(10)
+    expect(safeDueDay(-5)).toBe(10)
+    expect(safeDueDay(15)).toBe(15)
+    expect(safeDueDay(15.9)).toBe(15)
+  })
+})
+
+describe('dueDateOf', () => {
+  it('jatuh tempo pukul 23.59 WIB pada tanggal yang diminta', () => {
+    expect(dueDateOf('2026-09', 10)).toBe(wib('2026-09-10T23:59:00'))
+  })
+
+  it('tetap valid di Februari', () => {
+    // Tanggal 30 dibatasi ke 28 agar tidak melompat ke bulan berikutnya.
+    const due = new Date(dueDateOf('2026-02', 30) + 7 * 3600_000)
+    expect(due.getUTCMonth()).toBe(1)
+    expect(due.getUTCDate()).toBe(28)
+  })
+})
+
+describe('clampAmount', () => {
+  it('menolak nilai negatif dan pecahan', () => {
+    expect(clampAmount(-1)).toBe(0)
+    expect(clampAmount(50_000.7)).toBe(50_000)
+    expect(clampAmount(Number.NaN)).toBe(0)
+  })
+
+  it('membatasi salah ketik ekstrem', () => {
+    expect(clampAmount(999_999_999_999)).toBe(100_000_000)
+  })
+})
+
+describe('summarize', () => {
+  const charges = [
+    { amount: 50_000, status: 'paid' },
+    { amount: 50_000, status: 'paid' },
+    { amount: 50_000, status: 'awaiting_verification' },
+    { amount: 50_000, status: 'unpaid' },
+    { amount: 75_000, status: 'unpaid' },
+    { amount: 50_000, status: 'waived' },
+  ]
+
+  it('menghitung jumlah rumah per status', () => {
+    const s = summarize(charges)
+    expect(s.houses).toBe(6)
+    expect(s.paid).toBe(2)
+    expect(s.awaiting).toBe(1)
+    expect(s.unpaid).toBe(2)
+    expect(s.waived).toBe(1)
+  })
+
+  it('hanya mengakui uang yang sudah diverifikasi', () => {
+    const s = summarize(charges)
+    expect(s.collected).toBe(100_000)
+  })
+
+  it('tidak menagih rumah yang dibebaskan', () => {
+    // 5 rumah × nominalnya, tanpa yang waived: 50+50+50+50+75
+    expect(summarize(charges).billed).toBe(275_000)
+  })
+
+  it('aman untuk daftar kosong', () => {
+    expect(summarize([])).toMatchObject({ houses: 0, billed: 0, collected: 0 })
+  })
+})
diff --git a/server/dues-calc.ts b/server/dues-calc.ts
new file mode 100644
index 0000000..006177b
--- /dev/null
+++ b/server/dues-calc.ts
@@ -0,0 +1,107 @@
+/**
+ * Hitungan murni untuk iuran lingkungan — tanpa basis data.
+ *
+ * Dipisah dari `dues.ts` supaya bagian yang paling mudah salah (periode,
+ * jatuh tempo, rekap uang) bisa diuji tanpa menyentuh SQLite.
+ */
+
+/** Zona waktu acuan penagihan: WIB (UTC+7). */
+export const WIB_OFFSET = 7 * 60 * 60 * 1000
+
+/** Batas wajar nominal iuran, untuk menolak salah ketik ekstrem. */
+export const DUES_MAX_AMOUNT = 100_000_000
+
+const BULAN = [
+  'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
+  'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember',
+]
+
+/**
+ * Periode 'YYYY-MM' menurut WIB, bukan UTC.
+ *
+ * Penting: tagihan yang dibuat 1 September pukul 00.30 WIB harus masuk
+ * periode September, padahal saat itu UTC masih 31 Agustus.
+ */
+export function periodOf(at: number): string {
+  const d = new Date(at + WIB_OFFSET)
+  return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`
+}
+
+/** Judul bawaan tagihan rutin, mis. "Iuran September 2026". */
+export function periodTitle(period: string): string {
+  const [y, m] = period.split('-').map(Number)
+  const nama = BULAN[(m || 1) - 1] ?? ''
+  return `Iuran ${nama} ${y || ''}`.trim()
+}
+
+/** Batasi tanggal jatuh tempo ke 1-28 agar valid di bulan Februari. */
+export function safeDueDay(day: number): number {
+  const v = Math.trunc(Number(day))
+  if (!Number.isFinite(v) || v < 1) return 10
+  return Math.min(Math.max(v, 1), 28)
+}
+
+/** Jatuh tempo: tanggal `dueDay` pada periode tersebut, pukul 23.59 WIB. */
+export function dueDateOf(period: string, dueDay: number): number {
+  const [y, m] = period.split('-').map(Number)
+  return Date.UTC(y, (m || 1) - 1, safeDueDay(dueDay), 23, 59, 0) - WIB_OFFSET
+}
+
+/** Bersihkan nominal dari nilai negatif, pecahan, dan salah ketik ekstrem. */
+export function clampAmount(n: number): number {
+  const v = Math.trunc(Number(n))
+  if (!Number.isFinite(v) || v < 0) return 0
+  return Math.min(v, DUES_MAX_AMOUNT)
+}
+
+export interface ChargeLike {
+  amount: number
+  status: string
+}
+
+export interface BillSummary {
+  /** Jumlah rumah yang ditagih. */
+  houses: number
+  paid: number
+  awaiting: number
+  unpaid: number
+  waived: number
+  /** Total yang seharusnya masuk (tidak termasuk yang dibebaskan). */
+  billed: number
+  /** Yang sudah benar-benar lunas. */
+  collected: number
+}
+
+/**
+ * Rekap satu penagihan.
+ *
+ * Yang menunggu verifikasi TIDAK dihitung sebagai uang masuk — pengurus
+ * baru boleh mengakuinya setelah mutasi benar-benar dicek.
+ */
+export function summarize(charges: ChargeLike[]): BillSummary {
+  const s: BillSummary = {
+    houses: charges.length,
+    paid: 0,
+    awaiting: 0,
+    unpaid: 0,
+    waived: 0,
+    billed: 0,
+    collected: 0,
+  }
+  for (const c of charges) {
+    if (c.status === 'paid') {
+      s.paid += 1
+      s.collected += c.amount
+      s.billed += c.amount
+    } else if (c.status === 'awaiting_verification') {
+      s.awaiting += 1
+      s.billed += c.amount
+    } else if (c.status === 'waived') {
+      s.waived += 1
+    } else {
+      s.unpaid += 1
+      s.billed += c.amount
+    }
+  }
+  return s
+}
