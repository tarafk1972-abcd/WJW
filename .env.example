# Salin ke .env lalu isi. JANGAN commit .env ke Git.

# Port API (default 8787)
PORT=8787

# Lokasi basis data SQLite (default server/data/wjw.sqlite)
# WJW_DB=/var/lib/wjw/wjw.sqlite

# Sandi superadmin. Bila kosong, dibuat acak dan dicetak sekali ke log.
WJW_SUPERADMIN_PASSWORD=ganti-dengan-sandi-kuat

# Kunci notifikasi push — hasilkan dengan: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tarafk1972@gmail.com

# --- Pembayaran Mayar (https://mayar.id) ---
# Ambil dari web.mayar.id → Integration → API Key
MAYAR_API_KEY=
# Sandbox: https://api.mayar.club/hl/v1  |  Produksi: https://api.mayar.id/hl/v1
MAYAR_API_BASE=https://api.mayar.id/hl/v1
# Token rahasia untuk mengamankan webhook (bebas, buat sendiri)
MAYAR_WEBHOOK_TOKEN=

# Harga langganan (Rupiah)
WJW_PRICE_MONTHLY=149000
WJW_PRICE_YEARLY=1490000

# --- Email tagihan (SMTP) ---
# Contoh Gmail: smtp.gmail.com : 587, pakai App Password (bukan sandi akun)
# Contoh Zoho:  smtp.zoho.com  : 465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Warga Jaga Warga <noreply@domain-anda.com>
MAIL_REPLY_TO=tarafk1972@gmail.com

# Rekening untuk pembayaran manual (muncul di email bila tanpa tautan bayar)
WJW_BANK_INFO=BCA 1234567890
a.n. Yayasan Warga RW 05
