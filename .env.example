# Salin ke .env lalu isi. JANGAN commit .env ke Git.

# Port API (default 8787)
PORT=8787

# Lokasi basis data SQLite (default server/data/wjw.sqlite)
# WJW_DB=/var/lib/wjw/wjw.sqlite

# Sandi superadmin. Bila kosong, dibuat acak dan dicetak sekali ke log.
WJW_SUPERADMIN_PASSWORD=ganti-dengan-sandi-kuat

# WAJIB di produksi: 32 byte random, base64/base64url. Melindungi snapshot
# SOS dan profil medis dengan AES-256-GCM. JANGAN pernah mengganti kunci
# setelah data diproduksi tanpa rencana rotasi/dekripsi.
# Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WJW_DATA_ENCRYPTION_KEY=

# Kunci notifikasi push — hasilkan dengan: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tarafk1972@gmail.com

# --- Email tagihan (SMTP) ---
# Contoh Gmail: smtp.gmail.com : 587, pakai App Password (bukan sandi akun)
# Contoh Zoho:  smtp.zoho.com  : 465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Warga Jaga Warga <noreply@domain-anda.com>
MAIL_REPLY_TO=tarafk1972@gmail.com

# --- Pembayaran: QRIS ShopeePay (satu-satunya metode) ---
# Nama pemilik akun, tampil di aplikasi dan email
WJW_QRIS_NAME=FADLUL KHAIRA
WJW_QRIS_PHONE=(+62)81****781
# Taruh gambar QR di public/qris.png, atau isi URL penuh di sini
WJW_QRIS_IMAGE_URL=/qris.png
# Keterangan tambahan (opsional)
WJW_PAYMENT_INFO=

# Alamat publik aplikasi — wajib agar QR tampil di email
WJW_APP_URL=https://wargajagawarga.app

# --- Pembatasan laju endpoint publik ---
# Sengaja longgar: satu RW berbagi satu alamat IP publik, jadi seluruh
# warga tampak datang dari alamat yang sama. Lihat docs/SERVER-PUBLIK.md.
# WJW_RATE_LOGIN_MAX=120       # per 10 menit per alamat
# WJW_RATE_REGISTER_MAX=200    # per 1 jam per alamat

# --- Harga langganan (Rupiah) ---
WJW_PRICE_MONTHLY=149000
WJW_PRICE_YEARLY=1490000
# Berapa hari tagihan berlaku
WJW_INVOICE_DAYS=14
